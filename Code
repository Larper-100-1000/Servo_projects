#include <Servo.h>

Servo servo;

// Storing data servo
unsigned int servoData[3]; // moveTo, currentPos, speed
unsigned long servoMillis;

unsigned long currentMillis;// Current boardtime in milliseconds

int servoControl();

void setup() {
  Serial.begin(9600);
  Serial.println("MillisServo");
  servo.attach(9);  // attaches the servo on pin 9 to the Servo object
}

void loop() {
  int servoFinished;
  currentMillis = millis();

  servoFinished = servoControl(); // controls servo

  if(servoFinished < 1){
    servoData[0] = random(179);
    servoData[2] = random(1,100);
    Serial.print("Servo next pos: ");
    Serial.print(servoData[0]);
    Serial.print("Servo next speed: ");
    Serial.print(servoData[2]);
  }
}
  int servoControl(){
    int returnPos;
    returnPos = 0; // returns 0 if destination reached
    if(servoData[0] > 179){
      servoData[0] = 179; // Limit check
    }
    if(servoData[0] != servoData[1]){ // Checks if needed to be moved if equal no more movement needed
      if(currentMillis - servoMillis >= servoData[2]){ // is it time to move
        servoMillis = currentMillis;
        if(servoData[0] > servoData[1]){
          servoData[1]++;
        }
        else{
          servoData[1]--; 
        }
        servo.write(servoData[1]);
      }
      returnPos = 1;
    }
    return returnPos;
  }
